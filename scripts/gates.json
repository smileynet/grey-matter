{
  "full_triggers": ["package.json", "package-lock.json", "scripts/gates.json", "scripts/gate.mjs", "scripts/test-git-env.mjs", "scripts/test-git.config", ".githooks/pre-push"],
  "not_gated": {
    "scripts/orchestration-dashboard.test.mjs": "needs Playwright Core and an installed Chrome; run manually whenever the orchestration dashboard renderer or data changes",
    "scripts/check-guidance.mjs": "reads this host's installed guidance files, not the repository; the sync skill runs it",
    "scripts/delivery-dashboard-browser.test.mjs": "needs Playwright and a Chrome binary (CHROME_BIN); run it by hand before a release that changes the dashboard template"
  },
  "checks": [
    {
      "id": "plugin-manifest",
      "stage": "pre-push",
      "catches": "a plugin manifest that no longer matches disk, its sibling or the release tag, so consumer installs fail",
      "scope": [".claude-plugin/", ".codex-plugin/", ".agents/", ".kiro/", "skill-packs.json", "skills/", "scripts/deploy.mjs", "scripts/check-plugin-manifest.mjs"],
      "run": ["node", "scripts/check-plugin-manifest.mjs"],
      "timeout_s": 10,
      "measured": { "s": 1.4, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "skill-syntax",
      "stage": "pre-push",
      "catches": "malformed SKILL.md YAML or wrong core types, which harnesses reject on load",
      "scope": ["skills/", "scripts/check-skill-syntax.mjs"],
      "run": ["node", "scripts/check-skill-syntax.mjs"],
      "timeout_s": 10,
      "measured": { "s": 0.3, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "invocation-policy",
      "stage": "pre-push",
      "catches": "a user-invoked skill without its invocation sidecar, or a skill missing from its bucket README",
      "scope": ["skills/", "scripts/check-invocation-policy.mjs"],
      "run": ["node", "scripts/check-invocation-policy.mjs"],
      "timeout_s": 10,
      "measured": { "s": 0.2, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "doc-links",
      "stage": "pre-push",
      "catches": "a broken relative link or index entry that a skill or global rule points at",
      "scope": ["skills/", "global/", "docs/agents/", "scripts/check-docs-consistency.mjs"],
      "run": ["node", "scripts/check-docs-consistency.mjs"],
      "timeout_s": 10,
      "measured": { "s": 0.3, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "provider-fallback",
      "stage": "pre-push",
      "catches": "a malformed Provider fallback section in AGENTS.md, which agents must treat as no opt-in",
      "scope": ["AGENTS.md", "scripts/check-provider-fallback.mjs"],
      "run": ["node", "scripts/check-provider-fallback.mjs", "AGENTS.md"],
      "timeout_s": 10,
      "measured": { "s": 0.2, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "home-path",
      "stage": "pre-push",
      "catches": "this machine's home directory path in a tracked file, which leaks the account name into public history",
      "always": true,
      "run": ["node", "scripts/check-home-path.mjs"],
      "timeout_s": 10,
      "measured": { "s": 0.3, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "gates-coverage",
      "stage": "pre-push",
      "catches": "a new check or test script that no stage runs, so it silently never gates anything",
      "scope": ["scripts/"],
      "run": ["node", "scripts/check-gates-coverage.mjs"],
      "timeout_s": 10,
      "measured": { "s": 0.4, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "git-fixture-isolation",
      "stage": "pre-merge",
      "catches": "test fixtures loading the owner's signing keys, hooks or editor instead of their isolated Git config",
      "scope": ["scripts/test-git-env", "scripts/test-git.config"],
      "run": ["node", "--test", "scripts/test-git-env.test.mjs"],
      "timeout_s": 30,
      "measured": { "s": 3.0, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "gate-runner",
      "stage": "pre-merge",
      "catches": "a gate.mjs change that mis-selects checks, lets a hung check pass, or leaks its process tree",
      "scope": ["scripts/gate", ".githooks/"],
      "run": ["node", "--test", "scripts/gate.test.mjs"],
      "timeout_s": 120,
      "measured": { "s": 16.7, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "ticket-graph",
      "stage": "pre-merge",
      "catches": "a ticket graph with a cycle, a dangling blocker or a malformed ticket file",
      "scope": [".tickets/"],
      "run": ["tkt", "validate"],
      "timeout_s": 30,
      "measured": { "s": 0.3, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "skill-syntax-fixtures",
      "stage": "pre-merge",
      "catches": "a YAML checker change that accepts malformed frontmatter native validation misses",
      "scope": ["scripts/check-skill-syntax", "scripts/skill-syntax"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/skill-syntax.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 0.5, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "knowledge-relocation",
      "stage": "pre-merge",
      "catches": "adopt-project relocating or relinking knowledge files wrongly",
      "scope": ["scripts/relocate-knowledge", "skills/meta/adopt-project/scripts/relocate-knowledge"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/relocate-knowledge.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 2.2, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "agent-guidance",
      "stage": "pre-merge",
      "catches": "the global-rules installer clobbering text outside its managed block, or the guidance check missing a dead pointer",
      "scope": ["scripts/install-agents-md", "scripts/check-guidance", "global/"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/install-agents-md.test.mjs", "scripts/check-guidance.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 1.2, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "crew-uninstall",
      "stage": "pre-merge",
      "catches": "the crew-research uninstaller removing files outside its own install",
      "scope": ["scripts/uninstall-crew-research"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/uninstall-crew-research.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 0.6, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "repo-survey",
      "stage": "pre-merge",
      "catches": "adopt-project's portfolio survey putting a repo in the wrong tier",
      "scope": ["scripts/survey-repos", "skills/meta/adopt-project/scripts/survey-repos"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/survey-repos.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 1.7, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "artifact-hygiene",
      "stage": "pre-merge",
      "catches": "the artifact and footprint inspectors misclassifying a folder, or hanging (ticket 151)",
      "scope": ["scripts/repository-artifact-hygiene", "scripts/inspect-footprint", "scripts/scratch-citations-baseline.json", "skills/meta/repository-artifact-hygiene/scripts/"],
      "run": ["node", "--test", "scripts/repository-artifact-hygiene.test.mjs", "scripts/inspect-footprint.test.mjs"],
      "timeout_s": 120,
      "measured": { "s": 9.0, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "agent-shell-probe",
      "stage": "pre-merge",
      "catches": "the agent shell probe misreporting a harness's shell setting; POSIX only, all but one test skip on Windows",
      "scope": ["scripts/probe-agent-shell"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/probe-agent-shell.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 0.3, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "dashboard-contract",
      "stage": "pre-merge",
      "catches": "a delivery-dashboard template, checker or snapshot change that breaks the contract or its CLI (ticket 134)",
      "scope": ["scripts/delivery-dashboard", "skills/productivity/delivery-dashboard/"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/delivery-dashboard.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 1.4, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "review-receipt",
      "stage": "pre-merge",
      "catches": "a review receipt that stays accepted after its source or captures changed",
      "scope": ["scripts/review-receipt", "skills/productivity/delivery-dashboard/scripts/review-receipt"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/review-receipt.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 0.7, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "critic-model-probe",
      "stage": "pre-merge",
      "catches": "the critic model probe's Windows .cmd launch, safe model-ID boundary, documented Terra version floor and Sol availability diagnostic",
      "scope": ["scripts/probe-critic-model"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/probe-critic-model.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 0.3, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "orchestrate-spike-fixture",
      "stage": "pre-merge",
      "catches": "the orchestrate spike fixture escaping its sandbox or misreporting a run",
      "scope": ["scripts/spike-orchestrate-fixture"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/spike-orchestrate-fixture.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 3.3, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "harness-versions",
      "stage": "pre-merge",
      "catches": "harness-changelog's version detector missing an upgrade or misreading the baseline",
      "scope": ["scripts/harness-versions", "skills/meta/harness-changelog/"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/harness-versions.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 1.7, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "static-check-fixtures",
      "stage": "pre-merge",
      "catches": "a static check (links, indexes, invocation sidecars, plugin manifest, .scratch citations) that stops failing on the defect it exists for",
      "scope": ["scripts/check-docs-consistency", "scripts/check-invocation-policy", "scripts/check-plugin-manifest", "scripts/static-checks"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/static-checks.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 3.3, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "home-path-fixtures",
      "stage": "pre-merge",
      "catches": "a home-path check change that misses a path form or flags a generic one",
      "scope": ["scripts/check-home-path"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/check-home-path.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 0.5, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "provider-fallback-fixtures",
      "stage": "pre-merge",
      "catches": "a provider fallback validator change that accepts a malformed section",
      "scope": ["scripts/check-provider-fallback"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/check-provider-fallback.test.mjs"],
      "timeout_s": 60,
      "measured": { "s": 0.4, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "release-units",
      "stage": "pre-merge",
      "catches": "a release helper that publishes with the wrong credentials, version, registry or artifact set",
      "scope": ["scripts/release"],
      "run": ["node", "--test", "--test-timeout=60000", "scripts/release-cargo-credentials.test.mjs", "scripts/release-cargo-upload.test.mjs", "scripts/release-ci-artifacts.test.mjs", "scripts/release-github.test.mjs", "scripts/release-publish.test.mjs", "scripts/release-registry.test.mjs", "scripts/release-tkt-publication.test.mjs", "scripts/release-version.test.mjs"],
      "timeout_s": 120,
      "measured": { "s": 0.3, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "tkt-usage-compatibility",
      "stage": "pre-merge",
      "catches": "the tkt skill-pack compatibility audit missing unsupported commands or reusing help results for changed CLI, pack, command, directory or environment identities",
      "scope": ["scripts/verify-tkt-usage", "skills/meta/verify-tkt-usage/", "skills/meta/sync/SKILL.md"],
      "run": ["node", "--test", "scripts/verify-tkt-usage.test.mjs"],
      "timeout_s": 30,
      "measured": { "s": 3.5, "date": "2026-11-02", "host": "win" }
    },
    {
      "id": "model-eval-fixtures",
      "stage": "pre-merge",
      "catches": "a model evaluation that accepts staged or committed out-of-scope edits, zero tests, malformed output or a failed native turn",
      "scope": ["scripts/spike-model-eval", "scripts/fixtures/model-eval/", "scripts/spike-orchestrate-fixture.mjs"],
      "run": ["node", "--test", "scripts/spike-model-eval.test.mjs"],
      "timeout_s": 10,
      "measured": { "s": 2.1, "date": "2026-11-02", "host": "win" }
    },
    {
      "id": "deployer",
      "stage": "pre-release",
      "catches": "deploy.mjs writing outside the skill roots it owns, duplicating roots, or refreshing a plugin wrongly",
      "scope": ["scripts/deploy"],
      "run": ["node", "--test", "--test-timeout=300000", "scripts/deploy.test.mjs", "scripts/deploy-validation.test.mjs"],
      "timeout_s": 600,
      "measured": { "s": 91.9, "date": "2026-11-01", "host": "win" }
    },
    {
      "id": "release-integration",
      "stage": "pre-release",
      "catches": "the release flow tagging, pushing, verifying or publishing the wrong candidate in a real Git repository",
      "scope": ["scripts/release"],
      "run": ["node", "--test", "--test-concurrency=1", "--test-timeout=300000", "scripts/release-artifacts.test.mjs", "scripts/release-development.test.mjs", "scripts/release-entrypoints.test.mjs", "scripts/release-git.test.mjs", "scripts/release-native.test.mjs", "scripts/release-product.test.mjs", "scripts/release-verify.test.mjs", "scripts/release.test.mjs"],
      "timeout_s": 900,
      "measured": { "s": 145.9, "date": "2026-11-01", "host": "win" }
    }
  ]
}
