#!/usr/bin/env sh
# grey-matter pre-push hook — fast local backstop before a push reaches main.
#
# Runs the repo-consistency command (scripts/check-repo.mjs) and BLOCKS the push on a
# nonzero exit, catching a broken link, a lost invocation sidecar, or an index drift
# locally — before the push that AGENTS.md's "Working rhythm" does immediately, rather
# than only in CI (ticket 34) after it reaches the remote. Same command as CI; the hook
# is the local fast path, CI is the remote backstop.
#
# Opt-in: this is NOT forced on every clone. Install it with
#   node scripts/install-hooks.mjs        (or scripts/install-hooks.sh / .ps1)
# and remove it with
#   node scripts/install-hooks.mjs uninstall
#
# Degrades gracefully: if Node is not on PATH, the hook warns and allows the push rather
# than blocking work on a missing toolchain (CI remains the hard gate). tkt's own absence
# is already handled inside check-repo.mjs (skipped with a warning).

# Locate the repo root so the hook works regardless of the cwd git invokes it from.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found on PATH — skipping consistency check (CI still gates)." >&2
  exit 0
fi

echo "pre-push: running repo-consistency checks (node scripts/check-repo.mjs)..." >&2
if node "$ROOT/scripts/check-repo.mjs"; then
  exit 0
fi

echo "" >&2
echo "pre-push: consistency checks FAILED — push blocked." >&2
echo "  Fix the reported invariant, or bypass intentionally with: git push --no-verify" >&2
exit 1
